# DriveEasy settings. Copy to .env.local and fill in. No real values belong in this file.
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ---------- Database ----------
# Local: postgres://driveeasy:<password>@localhost:5432/driveeasy_dev
# Cloud: the hosted PostgreSQL connection string (must support the btree_gist extension)
DATABASE_URL=
TEST_DATABASE_URL=
# Local admin only; not used by the app
POSTGRES_SUPERUSER_PASSWORD=

# ---------- App ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------- Auth (Better Auth, email + password) ----------
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# ---------- Payments ----------
# fake = local test provider. Set to the real provider's name once its adapter exists.
PAYMENT_PROVIDER=fake
PAYMENTS_WEBHOOK_SECRET=
# Fake provider only
FAKE_PAYMENTS_WEBHOOK_URL=http://localhost:3000/api/webhooks/payments
FAKE_PAYMENTS_DUPLICATE_DELIVERIES=0
# Future cloud payment provider (e.g. Stripe)
PAYMENTS_SECRET_KEY=
NEXT_PUBLIC_PAYMENTS_PUBLISHABLE_KEY=

# ---------- File uploads ----------
# local = private folder on disk. Set to the cloud provider's name once its adapter exists.
STORAGE_PROVIDER=local
UPLOADS_SIGNING_SECRET=
# Local provider only (must be outside public/)
UPLOADS_DIR=./storage/uploads
# Future cloud object storage (S3-compatible)
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# ---------- Scheduled jobs ----------
# Cloud cron calls must send this secret
CRON_SECRET=
# Local runner: pnpm jobs <name> --every <seconds>
JOBS_INTERVAL_SECONDS=60
